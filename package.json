{
  "name": "@jacobsens/brand-kit",
  "version": "0.2.0",
  "private": true,
  "description": "Jacobsens brand tokens, components and documentation site",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens/tokens.css",
    "./fonts.css": "./dist/tokens/fonts.css",
    "./tailwind.css": "./dist/tokens/tailwind.css",
    "./tokens.json": "./dist/tokens/tokens.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "dev": "npm run tokens && vite dev",
    "build": "npm run tokens && vite build",
    "preview": "vite preview",
    "check": "npm run tokens && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "package": "npm run tokens && svelte-kit sync && svelte-package -i src/lib -o dist"
  },
  "devDependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^6.4.6"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
